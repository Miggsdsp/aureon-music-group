# Copy to .env.local-test. This is a local-only environment and must stay untracked.
AUREON_ENVIRONMENT=local-test
NEXT_PUBLIC_AUREON_ENVIRONMENT=local-test

# Fixed demo project: Firebase CLI routes this ID only to local emulators.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-aureon-music-group
FIREBASE_ADMIN_PROJECT_ID=demo-aureon-music-group
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-aureon-music-group.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:aureon-local-test
FIREBASE_ADMIN_STORAGE_BUCKET=demo-aureon-music-group.appspot.com

FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Local redirects keep verification and checkout returns on this machine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_CONTINUE_URL=http://localhost:3000

# For Checkout, uncomment and replace these with Stripe test-mode values in this
# ignored local file only. Keep secret values out of Git, logs and chat.
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# STRIPE_LISTENER_PRICE_ID=price_REPLACE_WITH_TEST_LISTENER_PRICE
# STRIPE_CREATOR_PRICE_ID=price_REPLACE_WITH_TEST_CREATOR_PRICE
# STRIPE_SUBSCRIPTION_TEST_WEBHOOK_SECRET=whsec_REPLACE_WITH_LOCAL_LISTENER_SECRET
